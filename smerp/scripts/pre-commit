#!/bin/sh

# === Git 루트 경로 가져오기 ===
PROJECT_ROOT=$(git rev-parse --show-toplevel)
GRADLE_DIR="$PROJECT_ROOT/smerp"

# === OS별 gradlew 선택 ===
if [ -f "$GRADLE_DIR/gradlew" ]; then
  GRADLEW_PATH="$GRADLE_DIR/gradlew"
elif [ -f "$GRADLE_DIR/gradlew.bat" ]; then
  GRADLEW_PATH="$GRADLE_DIR/gradlew.bat"
else
  echo "gradlew(.bat) not found under $GRADLE_DIR"
  exit 1
fi

# === Spotless 실행 ===
echo "Running spotlessApply. Formatting code..."
cd "$GRADLE_DIR" && "$GRADLEW_PATH" spotlessApply

if [ $? -ne 0 ]; then
  echo "Spotless apply failed!"
  exit 1
fi

# === 변경 파일 다시 add ===
stagedFiles=$(git diff --staged --name-only)
for file in $stagedFiles; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done
